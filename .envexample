# splashControl example settings file.
# Copy this to `.env` (or let start_splash.sh create one automatically) to
# fix your preferred values. Keys and defaults match start_splash.sh; values
# resolve CLI options > .env > built-in defaults, then are written back here.
#
# Safe to edit by hand. Manually edit `.env` if you have one.

# Default model: always offered in the model menu and restored as the current
# model when you pick "clear model history". Change this to make a different
# model your permanent fallback.
DEFAULT_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q2_K_XL

# Model to serve (splash model identifier, e.g. from huggingface.co)
MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q2_K_XL

# Previously entered models, most recent first, separated by ";".
# start_splash.sh shows these as numbered options in the model menu and
# updates this automatically; edit or trim it by hand if you like. The
# DEFAULT_MODEL is always offered even when it is not listed here.
MODEL_HISTORY=

# Time until the idle model is released from memory (Go duration string)
IDLE_RELEASE=90s

# Maximum disk cache size for model weights
MAX_CACHE_DISK=16G

# Context token limit (splash accepts e.g. 100K, where K = 1024 tokens;
# it can only lower the model's automatic limit)
MAX_CONTEXT=100K

# Agent to launch after splash starts (none/opencode/hermes/claude)
AGENT=none

# Whether to install a 'splashctl' launcher on your PATH so splashControl can be
# run from anywhere. Blank = ask once on the next interactive run; "yes" = keep
# it installed; "no" = never offer. Manage manually with --add-path/--remove-path.
PATH_ENTRY=